# Copy to .env.local for local dev; set the same values in the Vercel project.

# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Server-side refusal fallbacks re-run a request on another model if
# Opus 5's safety classifiers decline it, so a false positive on a benign
# question doesn't dead-end the demo. It's a beta — the handler falls back to a
# plain request automatically if the account can't use it. Set to 0 to skip.
ENABLE_REFUSAL_FALLBACK=1
